# Base URL of the Laravel API, without the trailing /api.
# Empty = same origin: in development the Vite proxy forwards /api and /storage to Laravel.
# In production (e.g. Vercel with rewrites) it can stay empty, or point to the API directly:
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Note: VITE_PROXY_TARGET and VITE_USE_POLLING are read by vite.config.ts from the
# process environment (set in compose.yaml), not from this file.